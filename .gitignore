# Node
node_modules/

# Frontend build output
dist/

# Rust build artifacts
target/
src-tauri/target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
**/mutants.out*/

# Generated icons (build.rs copies src-tauri/assets/icon.png here at build time)
src-tauri/icons/

# Generated Tauri schemas
src-tauri/gen/

# OS junk
.DS_Store
Thumbs.db

# Editor junk
.vscode/
.idea/
*.swp

# Local/testing state - never real user data, just scratch output
.remi-dev-data/

# Environment files that may hold secrets
.env
.env.local
