.showcase/
assets/tray/

# Frontend build output
dist/

# Rust build artifacts
target/
src-tauri/target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
**/mutants.out*/

# src-tauri/icons/ is CHECKED IN (the real bundle icon set: icon.icns,
# icon.ico, icon.png, and the PNG sizes bundle.icon references), generated
# once via `npx tauri icon assets/app-icon-512.png -o src-tauri/icons`.
# Not a build artifact - do not ignore it.

# Generated Tauri schemas
src-tauri/gen/

# OS junk
.DS_Store
Thumbs.db

# Editor junk
.vscode/
.idea/
*.swp

# Local/testing state - never real user data, just scratch output
.remi-dev-data/

# Environment files that may hold secrets
.env
.env.local
.claude/settings.local.json
.codegraph/

# Claude Code ephemeral state
.claude/scheduled_tasks.lock

