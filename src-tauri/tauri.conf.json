{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remi",
  "version": "0.1.0",
  "identifier": "com.immanuelsavio.remi",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5178",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": ".."
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": ".."
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "popover",
        "title": "Remi",
        "visible": false,
        "decorations": false,
        "skipTaskbar": true,
        "resizable": false,
        "width": 380,
        "height": 560
      },
      {
        "label": "dashboard",
        "title": "Remi",
        "visible": false,
        "decorations": true,
        "resizable": true,
        "width": 1180,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:",
      "capabilities": [
        {
          "identifier": "default",
          "description": "Window + notification permissions for both windows.",
          "windows": ["popover", "dashboard"],
          "permissions": [
            "core:default",
            "core:window:allow-show",
            "core:window:allow-hide",
            "core:window:allow-set-focus",
            "core:window:allow-set-position",
            "core:window:allow-set-always-on-top",
            "notification:default"
          ]
        }
      ]
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 Immanuel Savio",
    "category": "Productivity",
    "shortDescription": "A menu-bar time tracker for ADHD-friendly focus sessions.",
    "longDescription": "Remi is a lightweight macOS/Windows menu-bar app for tracking focus time on tasks and steps, built with ADHD-friendly workflows in mind: quick task switching, break tracking, and daily rollover.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
