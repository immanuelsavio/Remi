{
  "name": "dopamigo-packet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "//": "The Rust crate root is this same folder, so tauri needs no --config path.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "app": "tauri dev",
    "release": "tauri build",
    "verify": "npm run test && npm run check && npm run build && cargo test && cargo clippy -- -D warnings"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@tauri-apps/cli": "^2.1.0",
    "@tsconfig/svelte": "^5.0.4",
    "jsdom": "^24.1.3",
    "svelte": "^4.2.19",
    "svelte-check": "^3.8.6",
    "tslib": "^2.7.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^1.6.1"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
